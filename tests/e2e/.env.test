# Slurm git repo tag. See https://github.com/SchedMD/slurm/tags
SLURM_TAG=slurm-25-05-3-1

# Image version used to tag the container at build time
SLURM_VERSION=25.05.3

# Test environment configuration
# For internal container access (used by smoke tests)
SLURM_REMOTE=slurmctld-test
# For SSH access from host (used by library integration tests)
SLURM_REMOTE_SSH=localhost
SLURM_PORT=2222
SLURM_USERNAME=root
CPU_PARTITION=normal